-- Crystal ESP Variables
local espActive = false
local minValue = 2000000
local valueFilter = true
local espScale = 0.7
local espCache = {}
local espCount = 0

-- Helper Functions
local function getAttr(inst, name)
    local ok, value = pcall(inst.GetAttribute, inst, name)
    return ok and value or nil
end

local function crystalValue(inst)
    return tonumber(getAttr(inst, "Value")) or 0
end

local function crystalWeight(inst)
    return tonumber(getAttr(inst, "WeightKg")) or 0
end

local function crystalTier(inst)
    return tonumber(getAttr(inst, "Tier")) or 0
end

local function crystalName(inst)
    local name = getAttr(inst, "CrystalName")
    if type(name) == "string" and name ~= "" then
        return name
    end
    return inst.Name
end

local function crystalColor(inst)
    local r = tonumber(getAttr(inst, "TierColorR"))
    local g = tonumber(getAttr(inst, "TierColorG"))
    local b = tonumber(getAttr(inst, "TierColorB"))
    if r and g and b then
        return Color3.fromRGB(r, g, b)
    end
    return Color3.fromRGB(0, 225, 255)
end

local function formatShort(n)
    n = tonumber(n) or 0
    local suffixes = { "", "k", "M", "B", "T", "Qa" }
    local index = 0
    while n >= 1000 and index < #suffixes - 1 do
        n /= 1000
        index += 1
    end
    return string.format("$%.2f%s", n, suffixes[index + 1])
end

local function formatWeight(kg)
    kg = tonumber(kg) or 0
    if kg >= 1000 then
        return string.format("%.1fkg", kg / 1000)
    end
    return string.format("%.1fkg", kg)
end

local function parseValue(text)
    if type(text) ~= "string" then return nil end
    local cleaned = text:lower():gsub("[%s,%$_]", "")
    if cleaned == "" then return 0 end
    local number, suffix = cleaned:match("^(%d*%.?%d+)(%a*)$")
    if not number then return nil end
    local base = tonumber(number)
    if not base then return nil end
    local multipliers = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15 }
    if suffix == "" then return base end
    return base * (multipliers[suffix] or 1)
end

local function meetsFilter(inst)
    if not valueFilter then return true end
    return crystalValue(inst) >= minValue
end

-- Crystal ESP Functions
local function createEsp(inst)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "UniverseEsp"
    billboard.Adornee = inst
    billboard.AlwaysOnTop = true
    billboard.ResetOnSpawn = false
    billboard.LightInfluence = 0
    billboard.Size = UDim2.fromOffset(250 * espScale, 66 * espScale)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    billboard.MaxDistance = math.huge
    billboard.Parent = game:GetService("CoreGui")

    local textSize = math.max(6, math.floor(16 * espScale + 0.5))
    
    local rarity = Instance.new("TextLabel")
    rarity.Name = "Rarity"
    rarity.BackgroundTransparency = 1
    rarity.BorderSizePixel = 0
    rarity.Size = UDim2.new(1, 0, 1/3, 0)
    rarity.Position = UDim2.new(0, 0, 0, 0)
    rarity.Font = Enum.Font.GothamBold
    rarity.TextScaled = true
    rarity.TextTransparency = 0
    rarity.TextStrokeTransparency = 0
    rarity.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    rarity.TextColor3 = crystalColor(inst)
    rarity.RichText = false
    rarity.Text = ""
    rarity.Parent = billboard
    
    local info = rarity:Clone()
    info.Name = "Info"
    info.Position = UDim2.new(0, 0, 1/3, 0)
    info.TextColor3 = Color3.fromRGB(60, 255, 90)
    info.Parent = billboard
    
    local extra = rarity:Clone()
    extra.Name = "Extra"
    extra.Position = UDim2.new(0, 0, 2/3, 0)
    extra.TextColor3 = Color3.fromRGB(255, 255, 255)
    extra.RichText = true
    extra.Parent = billboard
    
    return { gui = billboard, rarity = rarity, info = info, extra = extra }
end

local function destroyEsp(inst)
    local entry = espCache[inst]
    if entry and entry.gui then
        entry.gui:Destroy()
    end
    espCache[inst] = nil
    espCount = math.max(0, espCount - 1)
end

local function updateEsp(inst)
    if not espActive or not inst.Parent then
        destroyEsp(inst)
        return
    end
    
    if getAttr(inst, "Collected") == true or not meetsFilter(inst) then
        destroyEsp(inst)
        return
    end
    
    local entry = espCache[inst]
    if not entry then
        entry = createEsp(inst)
        espCache[inst] = entry
        espCount = espCount + 1
    end
    
    local rarity = crystalTier(inst)
    local tierNames = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" }
    local tierName = tierNames[rarity] or "Unknown"
    local name = crystalName(inst)
    local mutation = getAttr(inst, "Mutation")
    
    local title
    if type(mutation) == "string" and mutation ~= "" then
        title = string.format("[%s] %s (%s)", tierName, name, mutation)
    else
        title = string.format("[%s] %s", tierName, name)
    end
    
    entry.rarity.Text = title
    entry.rarity.TextColor3 = crystalColor(inst)
    entry.info.Text = string.format("%s  •  %s", formatShort(crystalValue(inst)), formatWeight(crystalWeight(inst)))
    entry.extra.Text = string.format("Distance: --  •  Luck: +0%%")
end

local function clearEsp()
    for inst in pairs(espCache) do
        destroyEsp(inst)
    end
    espCache = {}
    espCount = 0
end

-- Crystal Scanning
local function scanCrystals()
    if not espActive then return end
    
    local crystalFolder = workspace:FindFirstChild("Crystals") or workspace:FindFirstChild("DroppedCrystals")
    if not crystalFolder then return end
    
    for _, child in pairs(crystalFolder:GetChildren()) do
        if child:IsA("BasePart") and getAttr(child, "Value") ~= nil then
            updateEsp(child)
        end
    end
end

-- ESP by Luck Feature
local espLuckValue = 100
local espLuckActive = false

local function updateEspByLuck()
    if not espLuckActive then return end
    
    local crystalFolder = workspace:FindFirstChild("Crystals") or workspace:FindFirstChild("DroppedCrystals")
    if not crystalFolder then return end
    
    -- Clear existing ESP first
    for inst in pairs(espCache) do
        destroyEsp(inst)
    end
    espCache = {}
    espCount = 0
    
    for _, child in pairs(crystalFolder:GetChildren()) do
        if child:IsA("BasePart") and getAttr(child, "Value") ~= nil then
            local luck = getAttr(child, "Luck")
            if luck and tonumber(luck) == espLuckValue then
                updateEsp(child)
            end
        end
    end
end

-- Player ESP
local playerEspActive = false
local playerEspCache = {}

local function createPlayerEsp(player)
    local character = player.Character
    if not character then return end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "UniversePlayerEsp"
    billboard.Adornee = root
    billboard.AlwaysOnTop = true
    billboard.ResetOnSpawn = false
    billboard.LightInfluence = 0
    billboard.Size = UDim2.fromOffset(220 * 0.6, 44 * 0.6)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, -8, 0)
    billboard.MaxDistance = math.huge
    billboard.Parent = game:GetService("CoreGui")
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "Name"
    nameLabel.BackgroundTransparency = 1
    nameLabel.BorderSizePixel = 0
    nameLabel.Size = UDim2.new(1, 0, 1/2, 0)
    nameLabel.Position = UDim2.new(0, 0, 0, 0)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextScaled = true
    nameLabel.TextTransparency = 0
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.TextColor3 = Color3.fromRGB(255, 40, 140)
    nameLabel.Text = player.DisplayName
    nameLabel.Parent = billboard
    
    local distanceLabel = nameLabel:Clone()
    distanceLabel.Name = "Distance"
    distanceLabel.Position = UDim2.new(0, 0, 1/2, 0)
    distanceLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    distanceLabel.Parent = billboard
    
    playerEspCache[player] = { gui = billboard, name = nameLabel, distance = distanceLabel }
end

local function clearPlayerEsp()
    for player, entry in pairs(playerEspCache) do
        if entry.gui then
            entry.gui:Destroy()
        end
    end
    playerEspCache = {}
end

local function updatePlayerEsp()
    if not playerEspActive then return end
    
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local origin = root and root.Position or nil
    
    for _, otherPlayer in pairs(game:GetService("Players"):GetPlayers()) do
        if otherPlayer ~= player then
            local entry = playerEspCache[otherPlayer]
            local character = otherPlayer.Character
            local target = character and character:FindFirstChild("HumanoidRootPart")
            
            if target and target.Parent then
                if not entry then
                    createPlayerEsp(otherPlayer)
                    entry = playerEspCache[otherPlayer]
                end
                if entry and entry.gui then
                    entry.gui.Adornee = target
                    if origin then
                        local distance = (target.Position - origin).Magnitude
                        entry.distance.Text = string.format("%dm", math.floor(distance + 0.5))
                    end
                end
            elseif entry then
                if entry.gui then
                    entry.gui:Destroy()
                end
                playerEspCache[otherPlayer] = nil
            end
        end
    end
end

-- Teleport Functions
local function getRoot()
    local character = player.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function findRemote(name)
    local folder = replicatedStorage:FindFirstChild("Remotes")
    if not folder then return nil end
    return folder:FindFirstChild(name)
end

local function fireRemote(name, ...)
    local remote = findRemote(name)
    if not remote then return false end
    local ok = pcall(function()
        remote:FireServer(...)
    end)
    return ok
end

