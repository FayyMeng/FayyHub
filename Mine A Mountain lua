_G.__ChunkLoadWatch = _G.__ChunkLoadWatch or {}
_G.__ChunkLoadWatch.token = (_G.__ChunkLoadWatch.token or 0) + 1
local myToken = _G.__ChunkLoadWatch.token

task.spawn(function()
    local Players = game:GetService("Players")
    local prevEnabled = nil
    local loadingName = ""

    while _G.__ChunkLoadWatch.token == myToken do
        task.wait(0.2)

        local player = Players.LocalPlayer
        if not player then
            continue
        end

        local pg = player:FindFirstChildOfClass("PlayerGui")
        local screen = pg and pg:FindFirstChild("MountainLoadingScreen")

        if screen then
            local enabled = screen.Enabled

            if prevEnabled == nil then
                prevEnabled = enabled
            elseif enabled and not prevEnabled then
                loadingName = ""

                local banner = screen:FindFirstChild("RarityBanner")
                local nameLbl = banner and banner:FindFirstChild("Name")

                if nameLbl and nameLbl:IsA("TextLabel") then
                    loadingName = nameLbl.Text
                end

                task.wait(10)

                if _G.__ChunkLoadWatch.token ~= myToken then
                    break
                end

                loadstring(game:HttpGet("https://raw.githubusercontent.com/FayyMeng/FayyHub/refs/heads/main/MineAMountain"))()
                break
            elseif not enabled and prevEnabled then
                prevEnabled = enabled
                continue
            end

            prevEnabled = enabled
        else
            prevEnabled = nil
        end
    end
end)
