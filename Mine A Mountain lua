local function destroyEntry(inst, entry)
    entry = entry or S.espCache[inst]
    if not entry then
        return
    end

    if entry.gui then
        entry.gui:Destroy()
    end

    S.espCache[inst] = nil
    S.espCount -= 1
    S.statsDirty = true
end

