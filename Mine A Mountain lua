-- Top Crystals Dropdown (Hanya Top 1)
local TopDropdown = TeleportSection:Dropdown({
    Title = "Teleport to Top Crystal",
    Desc = "Teleport to the #1 crystal by value, luck, or weight",
    Values = { "Top 1 Value", "Top 1 Luck", "Top 1 Weight" },
    Value = { "Top 1 Value" },
    Multi = false,
    Callback = function(option)
        local crystalFolder = workspace:FindFirstChild("Crystals") or workspace:FindFirstChild("DroppedCrystals")
        if not crystalFolder then
            WindUI:Notify({
                Title = "Error",
                Content = "Crystals not found!",
                Duration = 3,
                Icon = "alert-circle",
            })
            return
        end
        
        local best = nil
        local bestScore = 0
        
        for _, child in pairs(crystalFolder:GetChildren()) do
            if child:IsA("BasePart") and getAttr(child, "Value") ~= nil then
                local score = 0
                if option == "Top 1 Value" then
                    score = crystalValue(child)
                elseif option == "Top 1 Luck" then
                    score = getAttr(child, "Luck") or 0
                elseif option == "Top 1 Weight" then
                    score = crystalWeight(child)
                end
                
                if score > bestScore then
                    bestScore = score
                    best = child
                end
            end
        end
        
        if best and bestScore > 0 then
            local root = getRoot()
            if root then
                root.CFrame = best.CFrame + Vector3.new(0, 5, 0)
                WindUI:Notify({
                    Title = "Teleported!",
                    Content = string.format("Teleported to %s", option),
                    Duration = 3,
                    Icon = "map-pin",
                })
            end
        else
            WindUI:Notify({
                Title = "Error",
                Content = "No crystals found!",
                Duration = 3,
                Icon = "alert-circle",
            })
        end
    end
})

