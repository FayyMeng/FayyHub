local function crystalLuck(inst)
    local text = luckLabelText(inst)
    if type(text) == "string" then
        local pct = tonumber(text:match("([%d%.]+)%s*%%"))
        if pct and pct > 0 then
            return pct / 100
        end
    end
    return computeLuck(inst)
end

