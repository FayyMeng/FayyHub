            Move.setNoclip(true)
            Mountain.setAutoGrab(true)
        end

        local MoneyBox = Tabs.farm:Section({ Title = "Money Farm", Icon = "banknote", Opened = true })

        MoneyBox:Paragraph({
            Title = "Money Farming",
        })

        MoneyBox:Toggle({
            Title = "Auto Farm",
            Value = false,
