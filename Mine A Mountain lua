            end

            active = true
            target = nil
            columnY = nil
            columnDry = 0
            columnSwings = 0
            surfaceClock = 0
            peakClock = 0
            scanIndex = 0
            scanUntil = 0
            loaded = false
            loot = nil
            lootClock = 0
            lootHp = nil
            lootMax = nil
            lootBlocked = false
            swingClock = 0
            equipClock = 0
            sellSpot = nil
            sellUntil = 0
            heldPick = nil
