            Title = "Status",
        })

        local labelClock = 0

        moneyConn = RunService.Heartbeat:Connect(function(deltaTime)
            if active then
                local ok, err = pcall(step, deltaTime)
                if not ok then
                    reportError("moneyFarm", err)
                end
            end

            labelClock += deltaTime
            if labelClock >= 0.25 then
                labelClock = 0
                StatusLabel.Desc = statusText
            end
        end)

        Money.stop = stop
    end

    install()
end

