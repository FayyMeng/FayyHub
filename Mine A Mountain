-- Unload Button
do
    local SettingsBox = Tabs.settings:Section({ Title = "Settings", Icon = "sliders-horizontal", Opened = true })
    SettingsBox:Button({
        Title = "Unload",
        Desc = "Unload the script",
        Callback = function()
            State.espActive = false
            State.playerEspActive = false
            State.aimTpEnabled = false
            setSpeedBoost(false)
            finishTeleport()
            unwatchContainers()
            if Mountain.shutdown then
                Mountain.shutdown()
            end
            if Move.shutdown then
                Move.shutdown()
            end
            restoreInstantPrompts()
            table.clear(pendingActions)
            table.clear(promptRestores)
            table.clear(claimed)
            if Net.stop then
                Net.stop()
            end
            for _, connection in ipairs(netConns) do
                if connection then
                    connection:Disconnect()
                end
            end
            table.clear(netConns)
            
            -- Clean up AFK connections
            for _, connection in ipairs(afkConns) do
                if connection then
                    connection:Disconnect()
                end
            end
            table.clear(afkConns)
            
            if Farm and Farm.stop then
                Farm.stop()
            end
            if Money and Money.stop then
                Money.stop()
            end
            
            for _, connection in ipairs({
                aimInputConn,
                espConn,
                schedulerConn,
                characterConn,
                speedConn,
            }) do
                if connection then
                    connection:Disconnect()
                end
            end
            
            speedConn = nil
            speedHooked = nil
            aimInputConn = nil
            espConn = nil
            characterConn = nil
            
            clearRegistry()
            clearPlayerEsp()
            
            if EspHolder then
                EspHolder:Destroy()
                EspHolder = nil
            end
            
            State.rootPart = nil
            Window:Destroy()
        end
    })
end
